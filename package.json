{
  "name": "@capacitor/assets",
  "version": "3.0.18",
  "packageManager": "pnpm@10.11.1",
  "description": "Generate icon and splash screen images for Capacitor apps",
  "homepage": "https://ionicframework.com",
  "author": "Ionic Team <hi@ionicframework.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.3.0"
  },
  "bin": {
    "capacitor-assets": "./bin/capacitor-assets"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --maxWorkers=4",
    "lint": "pnpm run eslint && pnpm run prettier --check",
    "fmt": "pnpm run prettier --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier **/*.ts",
    "prepublishOnly": "pnpm run build"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "files": [
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionic-team/capacitor-assets.git"
  },
  "bugs": {
    "url": "https://github.com/ionic-team/capacitor-assets/issues"
  },
  "keywords": [
    "ionic",
    "capacitor",
    "resources",
    "mobile",
    "native",
    "icon",
    "splash screen"
  ],
  "dependencies": {
    "@ionic/cli-framework-output": "^2.2.8",
    "@ionic/utils-array": "^2.1.6",
    "@ionic/utils-fs": "^3.1.7",
    "@ionic/utils-subprocess": "^2.1.14",
    "@ionic/utils-terminal": "^2.3.5",
    "@trapezedev/project": "^7.1.4",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "fs-extra": "^11.3.3",
    "kleur": "^4.1.5",
    "node-html-parser": "^7.1.0",
    "prompts": "^2.4.2",
    "sharp": "^0.35.3",
    "tslib": "^2.8.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@changesets/cli": "^2.29.8",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/plist": "^3.0.5",
    "@types/yargs": "^17.0.35",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tempy": "^1.0.1",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.3"
  }
}
